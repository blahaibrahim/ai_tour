# Copy to .env.local. The Supabase pair is required for the Overview and Atlas
# tabs; everything else below is optional and shown at its default.

## Supabase — the project the Flutter app runs on.
##
## service_role, not anon, and on purpose: the numbers this dashboard shows
## (every explorer's captures, every model job, storage usage) are exactly what
## RLS hides from anon. That is also why neither name is NEXT_PUBLIC_ — the key
## is read server-side only and the browser gets aggregates and signed URLs.
##
## Consequence: run this locally. It is not something to deploy publicly.
## Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where the dashboard looks for clips to list and play.
# GSPLAT_VIDEO_DIR=./videos

# Where a finished .ply is saved on this machine so the splat viewer can load
# it. Ignored by git; delete it to reclaim the disk.
# GSPLAT_CACHE_DIR=./.splats

# A successful run copies the point clouds it produced into the directory above
# without being asked. Set to 0 to keep them in the Volume only and fetch them
# by hand from the splat card.
# GSPLAT_AUTO_FETCH=1

# Where modal_app.py lives. `modal run` is spawned with this as its cwd.
# GSPLAT_PIPELINE_DIR=../../backend/gaussian_splatting

# The Modal Volume the pipeline reads and writes.
# GSPLAT_VOLUME=gsplat-data

# The Modal CLI. Set this to a full path if `modal` is not on PATH for the
# process running `next dev` (a common Windows case).
# MODAL_BIN=modal

## "Send to the app" — publishing a splat and notifying the traveller whose
## footage it came from. Both are required for that one button; everything else
## in the dashboard works without them.
##
## APP_BACKEND_URL is the Node backend the phone talks to (backend/server-node),
## and NOTIFY_HOOK_SECRET must be the *same value* as NOTIFY_HOOK_SECRET in that
## server's own .env — it is how the backend tells this dashboard apart from the
## internet. Neither is NEXT_PUBLIC_: the secret is read server-side only.
# APP_BACKEND_URL=http://localhost:8000
# NOTIFY_HOOK_SECRET=

# Who is offered as the contributor on the publish form. This one *is*
# NEXT_PUBLIC_ because it is a default typed into a visible field, not a secret —
# see `PublishPanel` in components/Studio.tsx for why the dashboard cannot work
# it out for itself.
# NEXT_PUBLIC_CONTRIBUTOR_EMAIL=blib645@gmail.com
