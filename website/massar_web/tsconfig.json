{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],

      // Works around a packaging bug in @supabase/{realtime,functions}-js
      // 2.112.3: their published `dist/module/index.d.ts` re-exports from
      // `<pkg>/src/*` — the package's own TypeScript *sources* — rather than
      // from the `.d.ts` siblings beside it. That drags a few thousand lines of
      // unchecked library source into every consumer's program, where
      // `skipLibCheck` cannot help (it only skips `.d.ts`) and `exclude` cannot
      // either (it does not stop import following). `next build` then fails on
      // errors in code we do not own.
      //
      // Remapping those specifiers onto the `dist/module` tree — which mirrors
      // `src` file for file — lands them on the declarations that were meant to
      // be used. Type resolution only: the bundler resolves the real modules,
      // and the imports involved are types, so nothing changes at runtime.
      // Remove both lines once the upstream packages ship corrected types.
      "@supabase/realtime-js/src/*": ["./node_modules/@supabase/realtime-js/dist/module/*"],
      "@supabase/functions-js/src/*": ["./node_modules/@supabase/functions-js/dist/module/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
