## LLM (Groq — OpenAI-compatible)
GROQ_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.6-27b

GEMINI_API_KEY=

## Supabase — catalogue reads only, so the public anon key is correct here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...

## Needed only for POI ingestion (docs/backend/12) — service_role, not anon.
SUPABASE_SERVICE_ROLE_KEY=

## Contact info for the Overpass/Wikidata/Wikipedia User-Agent (fair-use policy).
OVERPASS_CONTACT=

## Modal Proxy Authentication
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
MODAL_SUBMIT_URL=

## Flask server (optional overrides)
PORT=8000
FLASK_DEBUG=0

## AR capture module (backend/server-node/src/arCapture) — signs capture
## tokens. Any long random string; required once ROUTE_GENERATION_MODE=real.
AR_CAPTURE_TOKEN_SECRET=
ROUTE_GENERATION_MODE=fixture

## Push notifications (docs/backend/15-notifications-and-fcm.md).
##
## The Firebase service account that signs FCM sends. Set ONE of these — the
## inline JSON if your host gives you environment variables, the path if it
## gives you a filesystem. Set neither and push is simply off: local
## notifications still work and only "your 3D model is ready, sent while the
## app was closed" is lost.
##
## A relative FIREBASE_SERVICE_ACCOUNT_PATH resolves against backend/ (this
## file's own directory), regardless of the server process's cwd — e.g. a key
## file saved at backend/my-key.json is just "my-key.json" here, not
## "backend/my-key.json" and not an absolute path (either also works).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

## Shared secret for POST /api/internal/model-job-notify, which the model_jobs
## database trigger calls through pg_net. Must match the `notify_hook_secret`
## row in `private.app_settings` — that endpoint has no user session behind it,
## so this is the whole of its authentication. Any long random string.
NOTIFY_HOOK_SECRET=
