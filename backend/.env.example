## LLM (Groq — OpenAI-compatible)
GROQ_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.6-27b

GEMINI_API_KEY=

## Supabase — catalogue reads only, so the public anon key is correct here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...

## Needed only for POI ingestion (docs/backend/12) — service_role, not anon.
SUPABASE_SERVICE_ROLE_KEY=

## Contact info for the Overpass/Wikidata/Wikipedia User-Agent (fair-use policy).
OVERPASS_CONTACT=

## Modal Proxy Authentication
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
MODAL_SUBMIT_URL=

## Flask server (optional overrides)
PORT=8000
FLASK_DEBUG=0

## AR capture module (backend/server-node/src/arCapture) — signs capture
## tokens. Any long random string; required once ROUTE_GENERATION_MODE=real.
AR_CAPTURE_TOKEN_SECRET=

## Route generation (backend/server-node/src/routeGeneration).
##
##   real     runs the orchestrator against the pois/cities/themes tables.
##   fixture  serves src/routeGeneration/fixtures.ts — every route invented.
##            Useful for working on the app with no database and no network;
##            never what a deployment should be running.
ROUTE_GENERATION_MODE=real

## Where the route cache lives — matrices, isochrones, and (the big one) the
## per-leg polylines from the routing provider.
##
## Leave it blank and the cache is in-memory: correct, but process-local, so
## every restart is cold and each replica pays for the same legs again. On a
## rate-limited provider plan that is the difference between a first route
## costing ~15 s and ~0.5 s.
##
## Any redis:// or rediss:// URL works — a local container, Redis Cloud, or
## Upstash. Only GET and SET-with-expiry are used.
##
##   docker run -d -p 6379:6379 redis:7-alpine
##   REDIS_URL=redis://localhost:6379
REDIS_URL=

## Routing provider for the route module. GraphHopper is primary (free plan,
## no credit card — note its free tier is non-commercial-use-only);
## OpenRouteService is the documented alternate.
##
## Leave both blank and route generation still works, but every duration and
## distance becomes a STRAIGHT-LINE ESTIMATE and the server says so on every
## request. Fine for development, wrong for anything a traveller sees.
GRAPHHOPPER_API_KEY=
ORS_API_KEY=

## How hard the provider may be hit: sustained requests/second, and how many
## may be spent at once. Measured against the GraphHopper free plan, which
## answers even modest bursts with "Minutely API limit heavily violated".
ROUTING_PROVIDER_RPS=1
ROUTING_PROVIDER_BURST=2

## Matrix sizing. The free plan caps the Matrix API at 5 points per axis and
## does not include the Isochrone API at all — the adapter detects both at
## runtime and stops asking, so nothing needs setting here to make a free key
## work.
##
## MAX_CALLS is how many tiled matrix calls one route may spend; tiling costs
## ceil(n/5)² calls, so 15 stops is 9. At 1 (the default) only a matrix that
## fits in a single call is fetched and anything larger is ordered by
## straight-line distance instead — correct for a free key, where those nine
## calls would crowd out the /route calls that draw the map. Raise both on a
## paid plan.
ROUTING_PROVIDER_MATRIX_MAX_POINTS=5
ROUTING_PROVIDER_MATRIX_MAX_CALLS=1

## Push notifications (docs/backend/15-notifications-and-fcm.md).
##
## The Firebase service account that signs FCM sends. Set ONE of these — the
## inline JSON if your host gives you environment variables, the path if it
## gives you a filesystem. Set neither and push is simply off: local
## notifications still work and only "your 3D model is ready, sent while the
## app was closed" is lost.
##
## A relative FIREBASE_SERVICE_ACCOUNT_PATH resolves against backend/ (this
## file's own directory), regardless of the server process's cwd — e.g. a key
## file saved at backend/my-key.json is just "my-key.json" here, not
## "backend/my-key.json" and not an absolute path (either also works).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

## Shared secret for POST /api/internal/model-job-notify, which the model_jobs
## database trigger calls through pg_net. Must match the `notify_hook_secret`
## row in `private.app_settings` — that endpoint has no user session behind it,
## so this is the whole of its authentication. Any long random string.
NOTIFY_HOOK_SECRET=
