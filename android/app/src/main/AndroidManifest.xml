<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The fennec hunt (InlineMascotHunt/HuntSessionController) is meant to
         keep tracking proximity while the app is backgrounded-but-alive — see
         docs/backend/15-notifications-and-fcm.md's "covers foreground and
         backgrounded-but-alive". Without this, Android 10+ silently stops
         delivering location updates the moment the app leaves the foreground,
         regardless of what ACCESS_FINE_LOCATION was granted, and the hunt
         goes dead with no error. Requested at runtime as `Permission.locationAlways`
         in inline_mascot_hunt.dart, on top of the ACCESS_FINE_LOCATION grant. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android 13+ gates notifications behind a runtime prompt. Without this
         declaration the request in NotificationService.enable() returns denied
         immediately and nothing is ever shown — on 12 and below the permission
         is implicit and this is ignored. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- The mascot hunt runs on ARCore. ar_flutter_plugin_2 already merges in
         `android.hardware.camera.ar` as required, which makes this an "AR
         Required" app: Play only offers it to ARCore-certified devices, and in
         exchange it installs Google Play Services for AR alongside the app.
         That matters because the plugin has no ARCore availability check of
         its own — on a device without it, the AR view would simply fail.
         To support non-AR devices instead, switch this value to "optional",
         add tools:replace to relax the plugin's uses-feature, and handle the
         unsupported case before opening ArHuntScreen. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="true"/>
    <application
        android:label="Massar"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Required by ARCore so Google Play installs Play Services for AR
             alongside the app. sceneview declares this "optional", which
             contradicts the plugin's required uses-feature and would leave the
             app device-filtered *and* without ARCore auto-install — so this
             overrides it. Must stay in step with the uses-feature above. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required"
            tools:replace="android:value" />

        <!-- Which channel an FCM message lands in when it arrives with the app
             closed and the payload names no channel of its own. Android drops a
             notification addressed to a channel that does not exist, silently
             and with nothing in logcat, so this has to match the channel
             NotificationService creates at startup. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="massar_default" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
